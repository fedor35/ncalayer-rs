# Пользовательский юнит: systemctl --user enable --now ncalayerd
# Окна выбора ключа/пароля и значок в трее требуют графической сессии, поэтому юнит привязан к ней.
# Иконка и .desktop: packaging/ncalayer-rs.svg, packaging/ncalayerd.desktop (автозапуск через ~/.config/autostart).
[Unit]
Description=ncalayer-rs — локальный сервис подписи ЭЦП НУЦ РК (wss://127.0.0.1:13579)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/ncalayerd run
Restart=on-failure
RestartSec=3
Environment=RUST_LOG=ncalayerd=info

[Install]
WantedBy=graphical-session.target
